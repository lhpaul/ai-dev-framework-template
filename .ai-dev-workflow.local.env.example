# Copy to .ai-dev-workflow.local.env (gitignored) and fill in a key.
# Source it before running the reviewer loop:
#   set -a && source .ai-dev-workflow.local.env && set +a

LOCAL_AI_REVIEWER_BACKEND=openai_compat
LOCAL_AI_REVIEWER_MODEL=deepseek-v4-pro
LOCAL_AI_REVIEWER_API_BASE_URL=https://api.deepseek.com

# Pick one:
# LOCAL_AI_REVIEWER_API_KEY=...
# DEEPSEEK_API_KEY=...
# LOCAL_AI_REVIEWER_API_KEY_COMMAND='op read "op://Personal/cerebro/deepseek-api"'
